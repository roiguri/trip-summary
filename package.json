{
  "name": "trip-summary",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199 NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 next dev -p 3100",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start -p 3100",
    "capture": "node scripts/capture.mjs",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test 'tests/unit/*.test.ts'",
    "test:store": "node scripts/firebase.mjs emulators:exec --only firestore,storage,auth \"node --test --test-concurrency=1 'tests/store/*.test.ts'\"",
    "emulators": "node scripts/firebase.mjs emulators:start --only firestore,storage,auth",
    "seed": "node scripts/seed.ts",
    "snapshot": "bash scripts/snapshot.sh",
    "check:interactions": "node scripts/check-interactions.mjs",
    "check:access": "node scripts/check-access.mjs",
    "check:import": "node scripts/check-import.mjs",
    "check:photos": "node scripts/check-photos.mjs",
    "format:check": "prettier --check .",
    "visual": "node scripts/visual.mjs",
    "visual:update": "node scripts/visual.mjs --update",
    "check:styles": "node scripts/style-diff.mjs",
    "mocks": "node scripts/make-mocks.ts"
  },
  "dependencies": {
    "@firebase/app": "^0.16.2",
    "@firebase/auth": "^1.13.6",
    "firebase-admin": "^14.5.0",
    "maplibre-gl": "^6.11.2",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18"
  },
  "overrides": {
    "gaxios": {
      "uuid": "^11.1.1"
    }
  }
}
