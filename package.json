{
  "name": "trip-summary",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev -p 3100",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start -p 3100",
    "capture": "node scripts/capture.mjs",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test 'tests/unit/*.test.ts'",
    "seed": "node scripts/seed.ts",
    "snapshot": "bash scripts/snapshot.sh",
    "check:interactions": "node scripts/check-interactions.mjs",
    "format:check": "prettier --check .",
    "visual": "node scripts/visual.mjs",
    "visual:update": "node scripts/visual.mjs --update",
    "check:styles": "node scripts/style-diff.mjs",
    "mocks": "node scripts/make-mocks.ts"
  },
  "dependencies": {
    "maplibre-gl": "^6.11.2",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
