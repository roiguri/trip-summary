rules_version = '2';
// Media is served only through the app's /media route, which checks the viewer's access on every
// request, and written only by the server, so direct client access is closed (docs/ARCHITECTURE.md).
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
